return {
    'mfussenegger/nvim-dap',
    dependencies = {
        'rcarriga/nvim-dap-ui',
        'theHamsta/nvim-dap-virtual-text',
        'nvim-neotest/nvim-nio',
        'mfussenegger/nvim-dap-python',
    },
    config = function()
        local dap = require('dap')
        local dapui = require('dapui')
        local map = vim.keymap


        -- ========================================================================
        -- DAP UI CONFIGURATION
        -- ========================================================================
        dapui.setup({
            layouts = {
                {
                    elements = {
                        { id = 'scopes', size = 0.25 },
                        { id = 'breakpoints', size = 0.25 },
                        { id = 'stacks', size = 0.25 },
                        { id = 'watches', size = 0.25 },
                    },
                    size = 40,
                    position = 'left',
                },
                {
                    elements = {
                        { id = 'repl', size = 0.5 },

                        { id = 'console', size = 0.5 },
                    },
                    size = 10,
                    position = 'bottom',
                },
            },
            controls = {
                enabled = true,
                element = "repl",
                icons = {
                    pause = "",
                    play = "",
                    step_into = "",
                    step_over = "",
                    step_out = "",
                    step_back = "",
                    run_last = "",
                    terminate = "",

                },
            },
            floating = {
                border = "rounded",
                mappings = {
                    close = { "q", "<Esc>" },
                },
            },
        })

        -- ========================================================================
        -- VIRTUAL TEXT CONFIGURATION
        -- ========================================================================
        require('nvim-dap-virtual-text').setup({
            enabled = true,

            enabled_commands = true,

            highlight_changed_variables = true,
            highlight_new_as_changed = true,
            show_stop_reason = true,
            commented = false,
            only_first_definition = true,
            all_references = false,
            clear_on_continue = false,
            virt_text_pos = 'eol',
            
            display_callback = function(variable, buf, stackframe, node, options)
                local value = variable.value:gsub("%s+", " ")
                local max_len = 50
                
                if #value > max_len then
                    value = value:sub(1, max_len - 3) .. "..."
                end
                
                return variable.name .. " = " .. value
            end,
        })

        -- ========================================================================
        -- AUTO-OPEN/CLOSE DAP UI
        -- ========================================================================
        dap.listeners.after.event_initialized['dapui_config'] = function()
            dapui.open()
        end
        dap.listeners.before.event_terminated['dapui_config'] = function()
            dapui.close()
        end
        dap.listeners.before.event_exited['dapui_config'] = function()
            dapui.close()
        end

        -- ========================================================================
        -- PERSISTENT BREAKPOINTS (optional but recommended)
        -- ========================================================================
        local breakpoints_file = vim.fn.stdpath('data') .. '/dap-breakpoints.json'

        local function load_breakpoints()
            if vim.fn.filereadable(breakpoints_file) == 1 then
                local data = vim.fn.readfile(breakpoints_file)

                local ok, breakpoints = pcall(vim.json.decode, table.concat(data))
                if ok and breakpoints then
                    for bufnr, buf_bps in pairs(breakpoints) do
                        local filepath = vim.api.nvim_buf_get_name(tonumber(bufnr))
                        if filepath and filepath ~= "" then
                            for _, bp in ipairs(buf_bps) do
                                dap.set_breakpoint(bp.condition, bp.hit_condition, bp.log_message)
                            end
                        end
                    end
                end
            end
        end

        local function save_breakpoints()
            local breakpoints = {}
            local bps = dap.breakpoints.get()
            if bps then

                for bufnr, buf_bps in pairs(bps) do
                    if buf_bps and #buf_bps > 0 then
                        breakpoints[bufnr] = buf_bps
                    end
                end
            end
            vim.fn.writefile({vim.json.encode(breakpoints)}, breakpoints_file)

        end

        vim.api.nvim_create_autocmd('VimLeavePre', {
            callback = save_breakpoints,
        })

        -- Load breakpoints after a short delay to ensure buffers are loaded
        vim.defer_fn(load_breakpoints, 100)

        -- ========================================================================
        -- KEYMAPS - All using <Leader>d prefix
        -- ========================================================================
        
        -- Core debugging controls (F-keys for quick access)
        map.set('n', '<F5>', dap.continue, { desc = 'DAP: Continue/Start' })
        map.set('n', '<F10>', dap.step_over, { desc = 'DAP: Step Over' })
        map.set('n', '<F11>', dap.step_into, { desc = 'DAP: Step Into' })
        map.set('n', '<F12>', dap.step_out, { desc = 'DAP: Step Out' })

        -- Breakpoints
        map.set('n', '<Leader>db', dap.toggle_breakpoint, { desc = 'DAP: Toggle Breakpoint' })
        map.set('n', '<Leader>dB', function()
            vim.ui.input({ prompt = 'Breakpoint condition: ' }, function(condition)
                if condition and condition ~= "" then
                    dap.set_breakpoint(condition)
                end
            end)
        end, { desc = 'DAP: Conditional Breakpoint' })
        map.set('n', '<Leader>dl', function()
            vim.ui.input({ prompt = 'Log point message: ' }, function(message)
                if message and message ~= "" then
                    dap.set_breakpoint(nil, nil, message)
                end
            end)
        end, { desc = 'DAP: Log Point' })
        map.set('n', '<Leader>dL', function()
            local bps = dap.breakpoints.get()
            if not bps or vim.tbl_isempty(bps) then
                vim.notify("No breakpoints set", vim.log.levels.INFO)
                return
            end
            
            local bp_list = {}
            for bufnr, buf_bps in pairs(bps) do
                local filepath = vim.api.nvim_buf_get_name(tonumber(bufnr))
                local filename = vim.fn.fnamemodify(filepath, ':t')
                for _, bp in ipairs(buf_bps) do
                    table.insert(bp_list, string.format("%s:%d", filename, bp.line))
                end
            end
            
            vim.notify("Breakpoints:\n" .. table.concat(bp_list, "\n"), vim.log.levels.INFO)
        end, { desc = 'DAP: List Breakpoints' })

        -- Session control
        map.set('n', '<Leader>dc', dap.continue, { desc = 'DAP: Continue' })
        map.set('n', '<Leader>dr', dap.restart, { desc = 'DAP: Restart' })
        map.set('n', '<Leader>dt', dap.terminate, { desc = 'DAP: Terminate' })
        map.set('n', '<Leader>dp', dap.pause, { desc = 'DAP: Pause' })
        map.set('n', '<Leader>dC', dap.run_to_cursor, { desc = 'DAP: Run to Cursor' })
        
        -- Configuration picker
        map.set('n', '<Leader>dd', function()
            require('dap').continue()
        end, { desc = 'DAP: Start/Continue (shows config picker)' })

        -- UI toggles
        map.set('n', '<Leader>du', dapui.toggle, { desc = 'DAP: Toggle UI' })
        map.set('n', '<Leader>ds', function()
            dapui.toggle({ layout = 1 })
        end, { desc = 'DAP: Toggle Sidebar' })
        map.set('n', '<Leader>dq', function()
            dapui.toggle({ layout = 2 })
        end, { desc = 'DAP: Toggle Console' })

        -- Evaluation and inspection
        map.set({'n', 'v'}, '<Leader>de', function()
            dapui.eval(nil, { enter = true })
        end, { desc = 'DAP: Eval Expression' })
        map.set('n', '<Leader>dh', function()
            require('dap.ui.widgets').hover()
        end, { desc = 'DAP: Hover Variables' })
        map.set('n', '<Leader>dw', function()
            vim.ui.input({ prompt = 'Watch expression: ' }, function(expr)
                if expr and #expr > 0 then
                    require('dapui').elements.watches.add(expr)
                end
            end)
        end, { desc = 'DAP: Add Watch' })

        -- REPL
        map.set('n', '<Leader>dR', dap.repl.open, { desc = 'DAP: Open REPL' })

        map.set('n', '<Leader>dx', function()
            vim.ui.input({ prompt = 'Expression: ' }, function(expr)
                if expr and expr ~= "" then
                    dap.repl.execute(expr)

                end
            end)
        end, { desc = 'DAP: Execute in REPL' })

        -- Virtual text toggle
        map.set('n', '<Leader>dv', ':DapVirtualTextToggle<CR>', { desc = 'DAP: Toggle Virtual Text' })

        -- Help
        map.set('n', '<Leader>d?', function()
            local help = [[
â•­â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ DAP Keymaps â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â•®
â”‚ F-Keys (Quick Access)                           â”‚
â”‚   <F5>          Continue/Start debugging        â”‚
â”‚   <F10>         Step Over                       â”‚

â”‚   <F11>         Step Into                       â”‚
â”‚   <F12>         Step Out                        â”‚
â”‚                                                  â”‚
â”‚ <Leader>d prefix                                â”‚
â”‚   b/B/l         Toggle/Conditional/Log BP       â”‚
â”‚   L             List all Breakpoints            â”‚
â”‚   c/r/t/p       Continue/Restart/Term/Pause     â”‚
â”‚   C             Run to Cursor                   â”‚
â”‚   d             Start (shows config picker)     â”‚
â”‚   u/s/q         Toggle UI/Sidebar/Console       â”‚
â”‚   e/h/w         Eval/Hover/Watch                â”‚
â”‚   R/x           REPL open/execute               â”‚
â”‚   v             Toggle Virtual Text             â”‚
â”‚   ?             This help                       â”‚
â”‚                                                  â”‚
â”‚ Navigation: <C-h/j/k/l> to move between windows â”‚
â•°â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â•¯
            ]]

            vim.notify(help, vim.log.levels.INFO, { title = "DAP Keymaps" })
        end, { desc = 'DAP: Show Help' })

        -- ========================================================================
        -- PYTHON DAP CONFIGURATION
        -- ========================================================================
        -- This needs to be here because nvim-dap-python is loaded as a dependency
        -- and its separate config file doesn't run
        
        local has_dap_python, dap_python = pcall(require, 'dap-python')
        if has_dap_python then
            dap_python.setup('python3')
            
            -- Load project-based configurations
            local customutils = require("Or1g3n.core.custom.utils")
            
            -- Get current project
            local function get_python_project()
                local cwd = vim.fn.getcwd()
                local projects = customutils.safe_require("Or1g3n.plugins.local.project_picker.projects", {})
                
                for _, project in ipairs(projects) do
                    if cwd:find(project.dir, 1, true) then
                        return project.name
                    end
                end
                return nil
            end
            
            -- Load configs
            local function load_python_configs()
                local project_name = get_python_project()
                
                if project_name then
                    local module_name = project_name:gsub("-", "_")
                    local configs = customutils.safe_require(
                        "Or1g3n.plugins.local.dap_configs." .. module_name,
                        nil
                    )
                    
                    if configs and type(configs) == "table" and #configs > 0 then
                        vim.notify("Loaded DAP configs for: " .. project_name, vim.log.levels.INFO)
                        return configs
                    end
                end
                
                -- Try default

                local default_configs = customutils.safe_require(
                    "Or1g3n.plugins.local.dap_configs.default",
                    nil
                )
                
                if default_configs and #default_configs > 0 then
                    vim.notify("Using default DAP configs", vim.log.levels.INFO)
                    return default_configs
                end
                
                -- Hardcoded fallback
                vim.notify("Using hardcoded DAP fallback", vim.log.levels.WARN)
                return {
                    {
                        name = 'Python: Current File',
                        type = 'python',
                        request = 'launch',
                        program = '${file}',

                        console = 'integratedTerminal',
                    },
                }
            end
            
            -- Set initial configs
            dap.configurations.python = load_python_configs()
            
            -- Reload on directory change
            vim.api.nvim_create_autocmd("DirChanged", {
                callback = function()
                    local new_configs = load_python_configs()
                    if #new_configs > 0 then
                        dap.configurations.python = new_configs
                    end
                end,
            })
            
            -- Manual reload command
            vim.keymap.set('n', '<Leader>drc', function()
                dap.configurations.python = load_python_configs()
            end, { desc = 'DAP: Reload Python Configs' })
        end

    end,

}
